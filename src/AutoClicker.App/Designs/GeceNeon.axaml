<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Gece Neon design: shapes, tabs and surfaces. Colours come from ThemeService. -->
    <Style Selector="Border.sidebar"><Setter Property="Width" Value="224" /></Style>

    <Style Selector="TabItem.profile-tab">
      <Setter Property="MinHeight" Value="34" /><Setter Property="Height" Value="36" />
      <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="16,6" /><Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="CornerRadius" Value="18" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Template">
        <ControlTemplate TargetType="TabItem">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem.profile-tab:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
    <Style Selector="TabItem.profile-tab:selected">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem.profile-tab:focus"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,0" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.sidebar"><Setter Property="Background" Value="{DynamicResource SidebarBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="0,0,1,0" /></Style>
    <Style Selector="Border.hero"><Setter Property="Margin" Value="28,18,28,10" /><Setter Property="Padding" Value="22,16" /><Setter Property="Background" Value="{DynamicResource SurfaceBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="18" /><Setter Property="BoxShadow" Value="0 0 24 0 #223DD6F5" /></Style>
    <Style Selector="Border.card"><Setter Property="Margin" Value="28,0,28,12" /><Setter Property="Padding" Value="8,10" /><Setter Property="Background" Value="{DynamicResource SurfaceBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="18" /></Style>
    <Style Selector="Border.bar"><Setter Property="Margin" Value="28,0,28,18" /><Setter Property="Padding" Value="20,10" /><Setter Property="Background" Value="{DynamicResource SurfaceBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /></Style>
    <Style Selector="Button.primary"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BoxShadow" Value="0 0 16 0 #663DD6F5" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="NumericUpDown"><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="ToggleButton.nav"><Setter Property="CornerRadius" Value="10" /></Style>
</Styles>
