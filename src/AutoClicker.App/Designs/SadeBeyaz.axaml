<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sade Beyaz design: shapes, tabs and surfaces. Colours come from ThemeService. -->
    <Style Selector="Border.sidebar"><Setter Property="Width" Value="216" /></Style>

    <Style Selector="TabItem.profile-tab">
      <Setter Property="MinHeight" Value="36" /><Setter Property="Height" Value="38" />
      <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="14,6" /><Setter Property="Margin" Value="0,0,2,6" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Template">
        <ControlTemplate TargetType="TabItem">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem.profile-tab:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
    <Style Selector="TabItem.profile-tab:selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,0" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.sidebar"><Setter Property="Background" Value="{DynamicResource SidebarBackground}" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Border.hero"><Setter Property="Margin" Value="32,20,32,6" /><Setter Property="Padding" Value="0" /></Style>
    <Style Selector="Border.card"><Setter Property="Margin" Value="32,6,32,14" /><Setter Property="Padding" Value="10,12" /><Setter Property="Background" Value="{DynamicResource SurfaceBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /><Setter Property="BoxShadow" Value="0 6 24 0 #14000000" /></Style>
    <Style Selector="Border.bar"><Setter Property="Padding" Value="32,12" /><Setter Property="Background" Value="#CCFFFFFF" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="0,1,0,0" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="BoxShadow" Value="0 2 10 0 #18000000" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="NumericUpDown"><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="ToggleButton.nav"><Setter Property="CornerRadius" Value="10" /></Style>
</Styles>
