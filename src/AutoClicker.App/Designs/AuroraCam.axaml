<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aurora Cam design: shapes, tabs and surfaces. Colours come from ThemeService. -->
    <Style Selector="Window"><Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#1B1033" Offset="0" /><GradientStop Color="#2B1B5C" Offset="0.55" /><GradientStop Color="#0F2A4A" Offset="1" /></LinearGradientBrush></Setter></Style>
    <Style Selector="Border.sidebar"><Setter Property="Width" Value="232" /></Style>

    <Style Selector="TabItem.profile-tab">
      <Setter Property="MinHeight" Value="34" /><Setter Property="Height" Value="36" />
      <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="16,6" /><Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="CornerRadius" Value="20" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#33C084FC" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Template">
        <ControlTemplate TargetType="TabItem">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem.profile-tab:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
    <Style Selector="TabItem.profile-tab:selected">
      <Setter Property="Background" Value="#55C084FC" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem.profile-tab:focus"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,0" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#4DC084FC" /><Setter Property="BorderBrush" Value="#80C084FC" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.sidebar"><Setter Property="Background" Value="#33000000" /><Setter Property="BorderBrush" Value="#22FFFFFF" /><Setter Property="BorderThickness" Value="0,0,1,0" /></Style>
    <Style Selector="Border.hero"><Setter Property="Margin" Value="26,20,26,10" /><Setter Property="Padding" Value="24,18" /><Setter Property="Background" Value="#22FFFFFF" /><Setter Property="BorderBrush" Value="#33FFFFFF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="24" /></Style>
    <Style Selector="Border.card"><Setter Property="Margin" Value="26,0,26,12" /><Setter Property="Padding" Value="10,12" /><Setter Property="Background" Value="#1AFFFFFF" /><Setter Property="BorderBrush" Value="#2BFFFFFF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="24" /></Style>
    <Style Selector="Border.bar"><Setter Property="Margin" Value="26,0,26,18" /><Setter Property="Padding" Value="22,10" /><Setter Property="Background" Value="#26FFFFFF" /><Setter Property="BorderBrush" Value="#33FFFFFF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="22" /></Style>
    <Style Selector="Button.primary"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BoxShadow" Value="0 4 18 0 #66C084FC" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="14" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="14" /></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="14" /></Style>
    <Style Selector="NumericUpDown"><Setter Property="CornerRadius" Value="14" /></Style>
    <Style Selector="ToggleButton.nav"><Setter Property="CornerRadius" Value="14" /></Style>
</Styles>
